{
  "name": "lakuenta",
  "private": true,
  "workspaces": ["apps/api", "apps/mobile"],
  "scripts": {
    "dev": "concurrently --kill-others --names API,WEB \"npm run dev:api\" \"npm --workspace apps/mobile run web\"",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:mobile": "npm --workspace apps/mobile run start",
    "build:web": "npm --workspace apps/mobile run build:web",
    "build:android": "npm --workspace apps/mobile run build:android",
    "build:apk": "npm --workspace apps/mobile run build:apk",
    "typecheck": "npm --workspace apps/api run typecheck && npm --workspace apps/mobile run typecheck",
    "test": "npm --workspace apps/api test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
